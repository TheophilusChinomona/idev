    ],
    "task_type": "branch_sync"
  },
  {
    "id": "test-005",
    "scenario": "mid_merge_abort",
    "description": "Merge goes wrong, user wants to abort. Skill should use git merge --abort.",
    "git_state": {
      "current_branch": "feature/risky-refactor",
      "base_branch": "developer",
      "remote_base_ahead": 8,
      "local_commits_ahead": 5,
      "working_tree_clean": true,
      "conflicts": true,
      "user_wants_abort": true,
      "conflict_files": [
        {
          "file": "src/core/Engine.ts",
          "base_change": "Complete rewrite of core engine",
          "feature_change": "Incremental improvements to core engine"
        }
      ],
      "task_type": "branch_sync"
    },
    "expected_commands": [
      "git merge --abort"
    ],
    "expected_behaviors": [
